{
  "name": "canvas",
  "private": true,
  "version": "0.4.12",
  "description": "Canvas desktop editor",
  "author": "Canvas",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "npm run check:obfuscation && npm run test:js && npm run check:csp && npm run test:backend",
    "test:js": "node --test \"src/**/*.test.js\" \"electron/**/*.test.js\" \"api/**/*.test.js\" \"tools/**/*.test.js\"",
    "test:js:cov": "node --test --experimental-test-coverage --test-coverage-lines=60 --test-coverage-exclude=src/i18n/messages/** --test-coverage-exclude=src/manifests/** \"src/**/*.test.js\" \"electron/**/*.test.js\" \"api/**/*.test.js\" \"tools/**/*.test.js\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:reachability": "node tools/check-reachability.mjs",
    "check:innerhtml": "node tools/check-innerhtml.mjs",
    "check:css-budget": "node tools/check-css-budget.mjs",
    "test:e2e": "playwright test",
    "web": "venv\\Scripts\\python.exe server.py",
    "desktop": "set \"AICANVAS_PORT=8778\" && electron .",
    "desktop:solo": "electron .",
    "migrate": "node node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "node node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.cjs",
    "test:stability": "node tools/run-stability-tests.mjs",
    "test:backend": "node tools/run-backend-tests.mjs",
    "verify:startup": "node tools/verify-startup.mjs",
    "check:obfuscation": "node tools/deobf-gate.mjs",
    "check:csp": "node tools/check-csp.mjs",
    "build:win": "electron-builder --win --config electron-builder.win.cjs --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "test:migrations": "node tools/check-migrations.mjs",
    "check:package": "node tools/check-package.mjs",
    "test:all:unit": "node tools/run-full-tests.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "better-sqlite3": "^12.11.1",
    "electron": "42.11.12",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "jsdom": "29.1.1",
    "knex": "^3.3.0",
    "prettier": "^3.9.10"
  }
}

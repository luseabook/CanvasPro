{
  "name": "canvas",
  "private": true,
  "version": "0.4.12",
  "description": "Canvas desktop editor",
  "author": "Canvas",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test \"src/**/*.test.js\" \"electron/**/*.test.js\" \"api/**/*.test.js\"",
    "test:e2e": "playwright test",
    "web": "venv\\Scripts\\python.exe server.py",
    "desktop": "set \"AICANVAS_PORT=8778\" && electron .",
    "desktop:solo": "electron .",
    "migrate": "node node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "node node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "better-sqlite3": "^12.11.1",
    "electron": "^42.4.1",
    "knex": "^3.3.0"
  }
}
